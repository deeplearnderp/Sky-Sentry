<Window x:Class="SkySentry.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:SkySentry.App.Views" Title="Sky Sentry" Width="1360" Height="820"
 MinWidth="1000" MinHeight="700" Background="#10151D" Foreground="#E2EAF4">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D8E3F0"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#26364B"/><Setter Property="Foreground" Value="#EDF4FF"/>
   <Setter Property="Padding" Value="12,6"/><Setter Property="BorderBrush" Value="#405670"/><Setter Property="Margin" Value="3"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#AEBFD3"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1723"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#405670"/><Setter Property="Padding" Value="5,3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#26364B"/><Setter Property="Foreground" Value="#10151D"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#D8E3F0"/><Setter Property="Foreground" Value="#10151D"/></Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#17202D"/><Setter Property="Foreground" Value="#DAE5F4"/>
   <Setter Property="RowBackground" Value="#17202D"/><Setter Property="AlternatingRowBackground" Value="#1C2939"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="28"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#243247"/><Setter Property="Foreground" Value="#9FB5CE"/><Setter Property="Padding" Value="8,7"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,2"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="300"/>
   <RowDefinition Height="8"/><RowDefinition Height="2*" MinHeight="200"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="SKY SENTRY" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding MonitoringState}" FontSize="11" Foreground="#6BDDB1" Margin="0,4,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding EventLifecycleLabel}" Foreground="#8CE5C0" Margin="0,0,12,0" VerticalAlignment="Center"/>
    <Button Content="Refresh cameras" Command="{Binding RefreshDevicesCommand}"/>
    <Button Content="Save Event" Command="{Binding SaveEventCommand}" Background="#186551" FontWeight="SemiBold"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <views:CameraPanelView DataContext="{Binding Camera1}"/>
   <views:CameraPanelView Grid.Column="2" DataContext="{Binding Camera2}"/>
  </Grid>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Background="#17202D" CornerRadius="8" Padding="10">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="ACTIVE TRACKS" FontWeight="SemiBold" Foreground="#A5BAD2"/>
      <TextBlock Text="{Binding ActiveTrackCount, StringFormat={}  ·  {0}}" Foreground="#6BDDB1"/>
      <TextBlock Text="   Angular values require FOV calibration" FontSize="11" Foreground="#738CA9"/>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveTracks}" SelectedItem="{Binding SelectedTrack}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Track" Binding="{Binding Id}" Width="120"/>
       <DataGridTextColumn Header="Camera" Binding="{Binding Camera}" Width="80"/>
       <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70"/>
       <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="80"/>
       <DataGridTextColumn Header="Peak" Binding="{Binding Peak}" Width="80"/>
       <DataGridTextColumn Header="Accel." Binding="{Binding Acceleration}" Width="85"/>
       <DataGridTextColumn Header="Turn" Binding="{Binding DirectionChange}" Width="65"/>
       <DataGridTextColumn Header="Size (px)" Binding="{Binding Size}" Width="80"/>
       <DataGridTextColumn Header="Class" Binding="{Binding Classification}" Width="60"/>
       <DataGridTextColumn Header="Score" Binding="{Binding AnomalyScore}" Width="60"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <TabControl Grid.Column="2" Background="#17202D" Foreground="#10151D" BorderBrush="#26364B">
    <TabItem Header="Track detail">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#17202D" Padding="12">
      <TextBlock Text="{Binding TrackDetail}" TextWrapping="Wrap" FontSize="12" LineHeight="22"/>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Recent Events">
     <ListBox ItemsSource="{Binding RecentEvents}" Background="#17202D" BorderThickness="0" Foreground="#D8E3F0">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
       <TextBlock Text="{Binding TriggeredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" Foreground="#A5BAD2"/>
       <TextBlock Text="{Binding EventId}" FontSize="10"/>
       <TextBlock Text="{Binding Status}" Foreground="#6BDDB1"/>
       <TextBlock Text="{Binding EventFolder}" TextWrapping="Wrap" FontSize="10"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </TabItem>
    <TabItem Header="Diagnostics">
     <ListBox ItemsSource="{Binding DiagnosticsLog}" Background="#17202D" BorderThickness="0" Foreground="#A5BAD2" FontSize="11"/>
    </TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="4" Background="#17202D" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding SystemHealth}" FontSize="11" Foreground="#91A8C3" TextWrapping="Wrap"/>
    <TextBlock Grid.Column="1" Text="{Binding SaveEventStatus}" Foreground="#E6C88B" Margin="12,0,0,0" MaxWidth="330" TextWrapping="Wrap" FontSize="11"/>
   </Grid>
  </Border>
 </Grid>
</Window>
